{
  "name": "OpenCAD Studio",
  "short_name": "OpenCAD",
  "description": "Free parametric 3D design: sketch, extrude, edit every step later, export STL.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1b1f25",
  "theme_color": "#1b1f25",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/json": [".ocad"], "model/stl": [".stl"], "model/obj": [".obj"] } }
  ]
}
