{
  "name": "opencad-studio",
  "productName": "OpenCAD Studio",
  "version": "1.0.0",
  "description": "A free, parametric 3D CAD app for Mac and Windows",
  "main": "electron/main.cjs",
  "type": "module",
  "license": "MIT",
  "author": "tkfam151",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node --test tests/*.test.js",
    "dist:mac": "vite build && electron-builder --mac",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^44.10.1",
    "electron-builder": "^26.18.0",
    "manifold-3d": "^3.5.4",
    "three": "^0.187.0",
    "vite": "^8.3.5"
  },
  "homepage": "https://github.com/tkfam151/3DCAD",
  "build": {
    "appId": "io.github.tkfam151.opencad",
    "productName": "OpenCAD Studio",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "fileAssociations": [
      {
        "ext": "ocad",
        "name": "OpenCAD Design",
        "role": "Editor",
        "icon": "build/icon.png"
      },
      {
        "ext": "stl",
        "name": "STL Model",
        "role": "Viewer"
      },
      {
        "ext": "obj",
        "name": "OBJ Model",
        "role": "Viewer"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenCAD Studio",
      "uninstallDisplayName": "OpenCAD Studio"
    }
  }
}
